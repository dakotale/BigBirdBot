<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>bigbirdbot.ico</ApplicationIcon>
    <Description>A Discord Bot</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="SQL\Database\Import Schema Logs\**" />
    <Compile Remove="DiscordBot.Tests\**" />
    <EmbeddedResource Remove="SQL\Database\Import Schema Logs\**" />
    <EmbeddedResource Remove="DiscordBot.Tests\**" />
    <None Remove="SQL\Database\Import Schema Logs\**" />
    <None Remove="DiscordBot.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="bigbirdbot.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="12.42.0" />
